# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it is listed in .gitignore).

MONGO_URI=mongodb://127.0.0.1:27017/shiftmanager
PORT=5000

# Long random string, e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Frontend origins allowed by CORS (dev server and production preview)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shiftmanager.local

# Used only by automated tests (separate database so real data is not touched)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/shiftmanager_test
