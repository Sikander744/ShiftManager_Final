{
  // VS Code debugging configurations for ShiftManager
  // Run and Debug panel (Ctrl+Shift+D) -> pick a configuration -> F5
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: debug server",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/server.js",
      "envFile": "${workspaceFolder}/backend/.env",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: debug Jest tests",
      "cwd": "${workspaceFolder}/backend",
      "runtimeArgs": ["--experimental-vm-modules"],
      "program": "${workspaceFolder}/backend/node_modules/jest/bin/jest.js",
      "args": ["--runInBand"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Frontend: debug in Chrome",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ]
}
